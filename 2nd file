## 5. Comprehensive Evaluation (`src/evaluate.py`)

```python
# src/evaluate.py
import time, json, numpy as np, pandas as pd, torch
from pathlib import Path
from sklearn.metrics import (
    precision_recall_fscore_support, roc_auc_score, confusion_matrix,
    classification_report, roc_curve, auc
)
from scipy import stats
import matplotlib.pyplot as plt
import seaborn as sns
from src.model_zoo import get_tokenizer, ONNXPhishModel, MODEL_REGISTRY

# ──────────────────────────────────────────────────────────────
# 1. LATENCY BENCHMARKING (CPU, batch=32, 100 runs)
# ──────────────────────────────────────────────────────────────
def benchmark_latency(model, texts: list[str], batch_size: int = 32, runs: int = 100) -> dict:
    # Warmup
    for _ in range(10):
        model.predict_proba(texts[:batch_size])
    
    latencies = []
    for _ in range(runs):
        start = time.perf_counter()
        model.predict_proba(texts[:batch_size])
        elapsed = (time.perf_counter() - start) * 1000 / batch_size  # ms per email
        latencies.append(elapsed)
    
    latencies = np.array(latencies)
    return {
        "mean_ms": float(latencies.mean()),
        "std_ms": float(latencies.std()),
        "p50_ms": float(np.percentile(latencies, 50)),
        "p90_ms": float(np.percentile(latencies, 90)),
        "p95_ms": float(np.percentile(latencies, 95)),
        "p99_ms": float(np.percentile(latencies, 99)),
        "throughput_eps": float(1000 / latencies.mean()),
    }

# ──────────────────────────────────────────────────────────────
# 2. BOOTSTRAP CONFIDENCE INTERVALS
# ──────────────────────────────────────────────────────────────
def bootstrap_ci(y_true, y_pred, y_prob, n_bootstrap=1000, ci=0.95):
    metrics = {"precision": [], "recall": [], "f1": [], "auc": []}
    n = len(y_true)
    for _ in range(n_bootstrap):
        idx = np.random.choice(n, n, replace=True)
        if len(np.unique(y_true[idx])) < 2: continue
        p, r, f1, _ = precision_recall_fscore_support(y_true[idx], y_pred[idx], average="binary", zero_division=0)
        metrics["precision"].append(p)
        metrics["recall"].append(r)
        metrics["f1"].append(f1)
        metrics["auc"].append(roc_auc_score(y_true[idx], y_prob[idx]))
    
    results = {}
    for k, v in metrics.items():
        if v:
            alpha = (1 - ci) / 2
            results[k] = {
                "mean": float(np.mean(v)),
                "ci_lower": float(np.percentile(v, alpha * 100)),
                "ci_upper": float(np.percentile(v, (1 - alpha) * 100)),
            }
    return results

# ──────────────────────────────────────────────────────────────
# 3. STATISTICAL SIGNIFICANCE (McNemar's Test)
# ──────────────────────────────────────────────────────────────
def mcnemar_test(y_true, pred_a, pred_b):
    """Compare two classifiers on same test set"""
    correct_a = (pred_a == y_true)
    correct_b = (pred_b == y_true)
    
    # Contingency table
    n00 = np.sum(~correct_a & ~correct_b)  # Both wrong
    n01 = np.sum(~correct_a & correct_b)   # A wrong, B right
    n10 = np.sum(correct_a & ~correct_b)   # A right, B wrong
    n11 = np.sum(correct_a & correct_b)    # Both right
    
    # McNemar's chi-square with continuity correction
    if n01 + n10 == 0:
        return {"chi2": 0, "p_value": 1.0, "significant": False}
    chi2 = (abs(n01 - n10) - 1) ** 2 / (n01 + n10)
    p_value = 1 - stats.chi2.cdf(chi2, df=1)
    return {"chi2": float(chi2), "p_value": float(p_value), "significant": p_value < 0.05}

# ──────────────────────────────────────────────────────────────
# 4. MAIN EVALUATION LOOP
# ──────────────────────────────────────────────────────────────
def evaluate_model(model_key: str, model_path: Path, test_df: pd.DataFrame, heldout_tests: dict, device: str = "cpu"):
    print(f"\n{'='*60}")
    print(f"Evaluating {model_key} ({MODEL_REGISTRY[model_key]['desc']})")
    print(f"{'='*60}")
    
    # Load ONNX INT8 model for latency (deployment scenario)
    tokenizer = get_tokenizer(model_key)
    onnx_path = model_path / f"{model_key}_int8.onnx"
    if onnx_path.exists():
        model = ONNXPhishModel(str(onnx_path), tokenizer)
        model_type = "ONNX_INT8"
    else:
        # Fallback to PyTorch
        from src.model_zoo import get_model
        model = get_model(model_key)
        model.load_state_dict(torch.load(model_path / "pytorch_model.bin", map_location=device))
        model.to(device).eval()
        model_type = "PyTorch"
    
    # Prepare test data
    texts = test_df["text"].tolist()
    labels = test_df["label"].values
    
    # Inference
    probs = model.predict_proba(texts)
    preds = (probs > 0.5).astype(int)
    
    # Metrics
    p, r, f1, _ = precision_recall_fscore_support(labels, preds, average="binary", zero_division=0)
    auc_score = roc_auc_score(labels, probs)
    cm = confusion_matrix(labels, preds)
    
    # Bootstrap CIs
    boot_ci = bootstrap_ci(labels, preds, probs)
    
    # Latency
    latency = benchmark_latency(model, texts)
    
    # Per-source breakdown
    source_metrics = {}
    for source in test_df["source"].unique():
        src_mask = test_df["source"] == source
        if src_mask.sum() < 10: continue
        src_labels = labels[src_mask]
        src_preds = preds[src_mask]
        src_probs = probs[src_mask]
        sp, sr, sf1, _ = precision_recall_fscore_support(src_labels, src_preds, average="binary", zero_division=0)
        source_metrics[source] = {
            "n": int(src_mask.sum()),
            "precision": float(sp),
            "recall": float(sr),
            "f1": float(sf1),
            "auc": float(roc_auc_score(src_labels, src_probs)) if len(np.unique(src_labels)) > 1 else 0.0
        }
    
    # Heldout source tests
    heldout_results = {}
    for name, heldout_df in heldout_tests.items():
        if len(heldout_df) < 10: continue
        h_texts = heldout_df["text"].tolist()
        h_labels = heldout_df["label"].values
        h_probs = model.predict_proba(h_texts)
        h_preds = (h_probs > 0.5).astype(int)
        hp, hr, hf1, _ = precision_recall_fscore_support(h_labels, h_preds, average="binary", zero_division=0)
        heldout_results[name] = {
            "n": len(heldout_df),
            "precision": float(hp),
            "recall": float(hr),
            "f1": float(hf1),
            "auc": float(roc_auc_score(h_labels, h_probs)) if len(np.unique(h_labels)) > 1 else 0.0
        }
    
    return {
        "model": model_key,
        "model_type": model_type,
        "overall": {
            "n": len(test_df),
            "precision": float(p),
            "recall": float(r),
            "f1": float(f1),
            "auc": float(auc_score),
            "confusion_matrix": cm.tolist(),
        },
        "bootstrap_ci": boot_ci,
        "latency_ms": latency,
        "per_source": source_metrics,
        "heldout_sources": heldout_results,
    }

def main():
    # Load test data
    test_df = pd.read_parquet("data/processed/test.parquet")
    heldout = {}
