# src/model_zoo.py
import torch
import torch.nn as nn
from transformers import (
    AutoModel, AutoConfig, AutoTokenizer,
    BertModel, RobertaModel, DistilBertModel,
    DebertaV2Model, ElectraModel, MobileBertModel,
    BigBirdModel
)
from torchcrf import CRF
from typing import Dict, Optional, Tuple
import onnxruntime as ort
from pathlib import Path
import numpy as np

# ──────────────────────────────────────────────────────────────
# 1. BASE CLASSIFIER WRAPPER
# ──────────────────────────────────────────────────────────────
class BasePhishClassifier(nn.Module):
    def __init__(self, model_name: str, num_labels: int = 2, dropout: float = 0.1):
        super().__init__()
        self.config = AutoConfig.from_pretrained(model_name)
        self.backbone = AutoModel.from_pretrained(model_name)
        self.dropout = nn.Dropout(dropout)
        self.classifier = nn.Linear(self.config.hidden_size, num_labels)
        
    def forward(self, input_ids, attention_mask, labels=None):
        outputs = self.backbone(input_ids=input_ids, attention_mask=attention_mask)
        # Use [CLS] token representation
        cls_output = outputs.last_hidden_state[:, 0]
        cls_output = self.dropout(cls_output)
        logits = self.classifier(cls_output)
        
        loss = None
        if labels is not None:
            loss_fct = nn.CrossEntropyLoss()
            loss = loss_fct(logits.view(-1, 2), labels.view(-1))
        return {"loss": loss, "logits": logits}

# ──────────────────────────────────────────────────────────────
# 2. CRF-AUGMENTED MODEL (BERT + CRF for sequence labeling)
# ──────────────────────────────────────────────────────────────
class BertCRFPhishClassifier(nn.Module):
    """BERT + CRF for token-level phishing cue detection + document classification"""
    def __init__(self, model_name: str, num_labels: int = 2, num_crf_labels: int = 3, dropout: float = 0.1):
        super().__init__()
        self.config = AutoConfig.from_pretrained(model_name)
        self.backbone = AutoModel.from_pretrained(model_name)
        self.dropout = nn.Dropout(dropout)
        # Token-level classifier for CRF (3 labels: O, PHISH_CUE, URGENCY_CUE)
        self.token_classifier = nn.Linear(self.config.hidden_size, num_crf_labels)
        self.crf = CRF(num_crf_labels, batch_first=True)
        # Document-level classifier
        self.doc_classifier = nn.Linear(self.config.hidden_size, num_labels)
        
    def forward(self, input_ids, attention_mask, token_labels=None, doc_labels=None):
        outputs = self.backbone(input_ids=input_ids, attention_mask=attention_mask)
        seq_output = outputs.last_hidden_state  # [batch, seq, hidden]
        cls_output = seq_output[:, 0]           # [batch, hidden]
        
        # Token-level logits for CRF
        token_logits = self.token_classifier(self.dropout(seq_output))
        
        # Document-level logits
        doc_logits = self.doc_classifier(self.dropout(cls_output))
        
        loss = None
        if doc_labels is not None:
            loss_doc = nn.CrossEntropyLoss()(doc_logits.view(-1, 2), doc_labels.view(-1))
            loss = loss_doc
        if token_labels is not None:
            # CRF loss (negative log-likelihood)
            loss_crf = -self.crf(token_logits, token_labels, mask=attention_mask.bool(), reduction="mean")
            loss = (loss or 0) + 0.5 * loss_crf
            
        return {"loss": loss, "logits": doc_logits, "token_logits": token_logits}

# ──────────────────────────────────────────────────────────────
# 3. MODEL FACTORY (8+ Architectures)
# ──────────────────────────────────────────────────────────────
MODEL_REGISTRY = {
    # 1. BERT-base (110M params)
