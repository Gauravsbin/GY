def parse_spamassassin(raw_dir: Path) -> pd.DataFrame:
    rows = []
    for label_dir, label in [("easy_ham", 0), ("spam", 1), ("hard_ham", 0)]:
        mbox_path = raw_dir / label_dir
        if not mbox_path.exists(): continue
        mbox = mailbox.mbox(str(mbox_path))
        for msg in mbox:
            body = _extract_text_body(msg)
            if len(body) < 50: continue
            rows.append({
                "source": "spamassassin",
                "subset": label_dir,
                "msg_id": msg.get("Message-ID", hashlib.md5(body.encode()).hexdigest()),
                "sender": msg.get("From", ""),
                "subject": msg.get("Subject", ""),
                "body": body,
                "label": label,
                "date": msg.get("Date", "")
            })
    return pd.DataFrame(rows)

def parse_enron(raw_dir: Path) -> pd.DataFrame:
    # Use pre-processed Enron CSV from Zenodo (enron.csv) to avoid 500k raw files
    csv_path = raw_dir / "enron.csv"
    if not csv_path.exists():
        raise FileNotFoundError("Download enron.csv from Zenodo phishing-email-curated-datasets")
    df = pd.read_csv(csv_path)
    df = df.rename(columns={"email": "body", "label": "label"})  # 0=ham, 1=spam/phish
    df["source"] = "enron"
    df["subset"] = "enron"
    df["msg_id"] = df.get("message_id", df["body"].apply(lambda x: hashlib.md5(x.encode()).hexdigest()))
    df["sender"] = df.get("sender", "unknown")
    df["subject"] = df.get("subject", "")
    df["date"] = df.get("date", "")
    return df[["source","subset","msg_id","sender","subject","body","label","date"]]

def parse_nazario(raw_dir: Path) -> pd.DataFrame:
    csv_path = raw_dir / "Nazario.csv"
    if not csv_path.exists():
        raise FileNotFoundError("Download Nazario.csv from Zenodo or GitHub rokibulroni/Phishing-Email-Dataset")
    df = pd.read_csv(csv_path)
    df = df.rename(columns={"Email_Text": "body", "Email_Type": "label_str"})
    df["label"] = df["label_str"].map({"Phishing Email": 1, "Safe Email": 0})
    df["source"] = "nazario"
    df["subset"] = "nazario"
    df["msg_id"] = df.get("Email_ID", df["body"].apply(lambda x: hashlib.md5(x.encode()).hexdigest()))
