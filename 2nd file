    df["date"] = ""
    return df[["source","subset","msg_id","sender","subject","body","label","date"]]

def parse_zenodo_curated(raw_dir: Path) -> pd.DataFrame:
    frames = []
    for fname in ["CEAS_08.csv", "Ling.csv", "Nazario.csv", "Enron.csv"]:
        fpath = raw_dir / fname
        if not fpath.exists(): continue
        df = pd.read_csv(fpath)
        # Normalize each known format
        if fname == "CEAS_08.csv":
            df = df.rename(columns={"body": "body", "label": "label"})
            df["source"] = "zenodo"
            df["subset"] = "ceas08"
        elif fname == "Ling.csv":
            df = df.rename(columns={"email": "body", "label": "label"})
            df["source"] = "zenodo"
            df["subset"] = "ling"
        # Nazario/Enron already handled above; skip to avoid double-count
        else:
            continue
        df["msg_id"] = df.get("id", df["body"].apply(lambda x: hashlib.md5(x.encode()).hexdigest()))
        df["sender"] = df.get("sender", "unknown")
        df["subject"] = df.get("subject", "")
        df["date"] = df.get("date", "")
        frames.append(df[["source","subset","msg_id","sender","subject","body","label","date"]])
    return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()

# ──────────────────────────────────────────────────────────────
# 2. TEXT EXTRACTION & NORMALIZATION
# ──────────────────────────────────────────────────────────────
def _extract_text_body(msg: email.message.Message) -> str:
    body = ""
    if msg.is_multipart():
        for part in msg.walk():
            if part.get_content_type() == "text/plain":
                payload = part.get_payload(decode=True)
                if payload:
                    body = payload.decode(errors="ignore")
                    break
    else:
        payload = msg.get_payload(decode=True)
        if payload:
            body = payload.decode(errors="ignore")
    # Normalize whitespace, remove excessive headers
    body = re.sub(r"\s+", " ", body).strip()
    body = re.sub(r"(?i)(from:|to:|subject:|date:|cc:|bcc:).*?\n", "", body)
    return body

def normalize_text(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df["body"] = df["body"].astype(str).apply(lambda x: re.sub(r"\s+", " ", x).strip())
    df["subject"] = df["subject"].astype(str).fillna("").apply(lambda x: re.sub(r"\s+", " ", x).strip())
    df["sender"] = df["sender"].astype(str).fillna("unknown").str.lower()
    # Extract sender domain for grouping
    df["sender_domain"] = df["sender"].apply(lambda x: x.split("@")[-1] if "@" in x else x)
    # Combined text for transformer input
    df["text"] = df["subject"] + " " + df["body"]
    return df

# ──────────────────────────────────────────────────────────────
# 3. NEAR-DUPLICATE REMOVAL (MinHash LSH)
# ──────────────────────────────────────────────────────────────
def minhash_dedupe(df: pd.DataFrame, threshold: float = 0.9, num_perm: int = 128) -> pd.DataFrame:
    lsh = MinHashLSH(threshold=threshold, num_perm=num_perm)
    minhashes = {}
    keep_idx = []
    
    for idx, row in df.iterrows():
        text = row["text"]
        if len(text) < 20:
            keep_idx.append(idx)
            continue
        m = MinHash(num_perm=num_perm)
        for token in text.split():
            m.update(token.encode())
        # Check for near-duplicate
        duplicates = lsh.query(m)
        if not duplicates:
            lsh.insert(str(idx), m)
            minhashes[idx] = m
            keep_idx.append(idx)
    return df.loc[keep_idx].reset_index(drop=True)

# ──────────────────────────────────────────────────────────────
# 4. LEAKAGE-FREE SPLITTING (Source + Campaign Aware)
# ──────────────────────────────────────────────────────────────
def create_group_key(df: pd.DataFrame) -> pd.Series:
    """Group by sender domain + subject prefix (first 30 chars)"""
    subj_prefix = df["subject"].str.lower().str[:30].fillna("")
    return df["sender_domain"] + "|" + subj_prefix

def leakage_free_split(
    df: pd.DataFrame,
    test_size: float = 0.15,
    val_size: float = 0.15,
    seed: int = 42,
    group_col: str = "group_key"
) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    df = df.copy()
    df[group_col] = create_group_key(df)
    
    # First split: train vs (val+test)
    gss = GroupShuffleSplit(n_splits=1, test_size=test_size+val_size, random_state=seed)
    train_idx, temp_idx = next(gss.split(df, groups=df[group_col]))
    
    # Second split: val vs test
    temp_df = df.iloc[temp_idx].reset_index(drop=True)
    gss2 = GroupShuffleSplit(n_splits=1, test_size=test_size/(test_size+val_size), random_state=seed)
    val_idx, test_idx = next(gss2.split(temp_df, groups=temp_df[group_col]))
    
    train = df.iloc[train_idx].reset_index(drop=True)
    val = temp_df.iloc[val_idx].reset_index(drop=True)
    test = temp_df.iloc[test_idx].reset_index(drop=True)
    
    # Verify zero group overlap
    for name_a, df_a, name_b, df_b in [
        ("train", train, "val", val),
        ("train", train, "test", test),
        ("val", val, "test", test)
    ]:
        overlap = set(df_a[group_col]) & set(df_b[group_col])
        assert not overlap, f"Leakage: {len(overlap)} groups shared between {name_a} and {name_b}"
    
    return train, val, test

def create_source_heldout_tests(df: pd.DataFrame, test_df: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    """Create additional test sets held out by source"""
    heldout = {}
    for source in df["source"].unique():
        if source in test_df["source"].unique(): continue
        heldout[f"heldout_{source}"] = df[df["source"] == source].reset_index(drop=True)
    return heldout

# ──────────────────────────────────────────────────────────────
# 5. MAIN PIPELINE (Hydra Configurable)
# ──────────────────────────────────────────────────────────────
@hydra.main(config_path="../configs", config_name="data", version_base=None)
def main(cfg: DictConfig):
    raw_dir = Path(cfg.paths.raw)
    proc_dir = Path(cfg.paths.processed)
    proc_dir.mkdir(parents=True, exist_ok=True)
    
    # Download & parse each corpus
    parsers = {
        "spamassassin": parse_spamassassin,
        "enron": parse_enron,
        "nazario": parse_nazario,
        "hf_phishing": parse_hf_phishing,
        "zenodo": parse_zenodo_curated,
    }
    
    frames = []
    for name, parser in parsers.items():
        if name in cfg.enabled_corpora:
            print(f"Parsing {name}...")
            frames.append(parser(raw_dir))
    
    full_df = pd.concat(frames, ignore_index=True)
    print(f"Total raw emails: {len(full_df)}")
    print(full_df.groupby(["source","label"]).size().unstack(fill_value=0))
    
    # Normalize
    full_df = normalize_text(full_df)
    
    # Exact dedupe (body hash)
    full_df["body_hash"] = full_df["body"].apply(lambda x: hashlib.md5(x.encode()).hexdigest())
    full_df = full_df.drop_duplicates(subset="body_hash").reset_index(drop=True)
    print(f"After exact dedupe: {len(full_df)}")
    
    # Near-dedupe (MinHash LSH)
    if cfg.dedupe.near_dedupe:
        full_df = minhash_dedupe(full_df, threshold=cfg.dedupe.threshold, num_perm=cfg.dedupe.num_perm)
        print(f"After near-dedupe: {len(full_df)}")
    
    # Leakage-free split
    train, val, test = leakage_free_split(
        full_df,
        test_size=cfg.split.test_size,
        val_size=cfg.split.val_size,
        seed=cfg.split.seed
    )
    
    # Source-heldout tests
    heldout = create_source_heldout_tests(full_df, test)
    
    # Save splits
    for name, split_df in [("train", train), ("val", val), ("test", test)] + list(heldout.items()):
        out_path = proc_dir / f"{name}.parquet"
        split_df.to_parquet(out_path)
        print(f"{name}: {len(split_df)} emails | Phish rate: {split_df['label'].mean():.3f}")
    
    # Save split metadata
    meta = {
        "split_seed": cfg.split.seed,
        "train_size": len(train),
        "val_size": len(val),
        "test_size": len(test),
        "heldout_sources": list(heldout.keys()),
        "class_dist_train": train["label"].value_counts().to_dict(),
        "class_dist_test": test["label"].value_counts().to_dict(),
        "sources_in_train": train["source"].unique().tolist(),
        "sources_in_test": test["source"].unique().tolist(),
    }
    import json
    (proc_dir / "split_meta.json").write_text(json.dumps(meta, indent=2))

if __name__ == "__main__":
    main()
