// gmail_addon/Code.gs
const API_CONFIG = {
  URL: "https://phishguard-api-xyz-uc.a.run.app/predict",  // Your Cloud Run URL
  TIMEOUT_MS: 5000,
  CACHE_TTL: 300  // 5 min cache for repeated opens
};

const CACHE = CacheService.getScriptCache();

function onGmailMessageOpen(e) {
  const messageId = e.gmail.messageId;
  const accessToken = e.gmail.accessToken;
  GmailApp.setCurrentMessageAccessToken(accessToken);
  
  const msg = GmailApp.getMessageById(messageId);
  const subject = msg.getSubject() || "";
  const body = msg.getPlainBody().slice(0, 8000);  // Truncate for latency
  const sender = msg.getFrom() || "";
  
  // Check cache first
  const cacheKey = `phishguard_${messageId}`;
  const cached = CACHE.get(cacheKey);
  if (cached) {
    return [buildCard(JSON.parse(cached), true)];
  }
  
  // Call API
  const result = callPhishGuardAPI(subject, body, sender);
  if (result) {
    CACHE.put(cacheKey, JSON.stringify(result), API_CONFIG.CACHE_TTL);
    return [buildCard(result, false)];
  }
  
  return [buildErrorCard("Analysis failed")];
}

function callPhishGuardAPI(subject, body, sender) {
  try {
    const response = UrlFetchApp.fetch(API_CONFIG.URL, {
      method: "POST",
      contentType: "application/json",
      payload: JSON.stringify({ subject, body, sender }),
      muteHttpExceptions: true,
      headers: { "Authorization": `Bearer ${ScriptApp.getOAuthToken()}` }
    });
    
    if (response.getResponseCode() === 200) {
      return JSON.parse(response.getContentText());
    }
    console.error(`API Error: ${response.getResponseCode()} ${response.getContentText()}`);
  } catch (err) {
    console.error(`API Call Failed: ${err}`);
  }
  return null;
}

function buildCard(result, fromCache) {
  const prob = result.phish_probability;
  const pct = (prob * 100).toFixed(1);
  const isPhish = result.is_phishing;
  const latency = result.latency_ms.toFixed(1);
  
  const color = isPhish ? "#ea4335" : "#34a853";
  const icon = isPhish ? "WARNING" : "CHECK_CIRCLE";
  const verdict = isPhish ? "🚨 PHISHING DETECTED" : "✅ LIKELY SAFE";
  const badge = fromCache ? " ⚡ CACHED" : "";
  
  const card = CardService.newCardBuilder()
    .setHeader(CardService.newCardHeader()
      .setTitle("PhishGuard Analysis")
      .setSubtitle(`Latency: ${latency}ms${badge}`))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newDecoratedText()
        .setTopLabel("Phishing Probability")
        .setText(`<font color="${color}"><b>${pct}%</b></font>`)
        .setWrapText(true))
      .addWidget(CardService.newDecoratedText()
        .setTopLabel("Verdict")
        .setText(verdict)
        .setIcon(icon))
      .addWidget(CardService.newTextParagraph()
        .setText(`<b>Sender:</b> ${result.sender}<br><b>Subject:</b> ${result.subject}`))
      .addWidget(CardService.newButtonSet()
        .addButton(CardService.newTextButton()
          .setText(isPhish ? "Report & Delete" : "Mark Safe")
          .setOnClickAction(CardService.newAction()
            .setFunctionName(isPhish ? "reportPhishing" : "markSafe")
            .setParameters({ messageId: result.message_id }))))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph()
        .setText("⚡ Powered by DeBERTa-v3-small INT8 • <a href='https://github.com/yourrepo/phishguard'>Open Source</a>")))
    .build();
  
  return card;
}

function reportPhishing(e) {
  const messageId = e.parameters.messageId;
  // Forward to security team / PhishTank / internal SIEM
  const msg = GmailApp.getMessageById(messageId);
  msg.moveToTrash();
  // Call reporting API
  return CardService.newActionResponseBuilder()
    .setNotification(CardService.newNotification().setText("🚨 Reported & moved to Trash"))
    .build();
}

function markSafe(e) {
  return CardService.newActionResponseBuilder()
    .setNotification(CardService.newNotification().setText("✅ Marked as safe"))
    .build();
}

function buildErrorCard(msg) {
  return CardService.newCardBuilder()
    .setHeader(CardService.newCardHeader().setTitle("PhishGuard Error"))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph().setText(msg)))
    .build();
