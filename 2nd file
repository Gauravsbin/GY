## 6. One-Command Experiment Sweep (`run_experiment.py`)

```python
# run_experiment.py
#!/usr/bin/env python3
"""
Run full 8-model experiment with 3 seeds each (24 training runs).
Usage: python run_experiment.py [--models model1,model2] [--seeds 42,123,456]
"""
import subprocess, sys, argparse, itertools
from pathlib import Path

MODELS = [
    "bert_base", "roberta_base", "distilbert_base",
    "deberta_v3_small", "electra_small", "mobilebert",
    "bigbird_roberta", "bert_crf"
]

def run_cmd(cmd, desc):
    print(f"\n{'='*60}")
    print(f"▶ {desc}")
    print(f"$ {' '.join(cmd)}")
    print(f"{'='*60}")
    result = subprocess.run(cmd, capture_output=False)
    if result.returncode != 0:
        print(f"❌ FAILED: {desc}")
        sys.exit(1)
    print(f"✅ COMPLETED: {desc}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--models", default=",".join(MODELS))
    parser.add_argument("--seeds", default="42,123,456")
    parser.add_argument("--skip-data", action="store_true")
    parser.add_argument("--skip-train", action="store_true")
    parser.add_argument("--skip-eval", action="store_true")
    args = parser.parse_args()
    
    models = args.models.split(",")
    seeds = [int(s) for s in args.seeds.split(",")]
    
    # 1. Data Preparation
    if not args.skip_data:
        run_cmd([sys.executable, "-m", "src.data_prep"], "Data Preparation (Multi-corpus + Leakage-free Split)")
    
    # 2. Training Sweep
    if not args.skip_train:
        for model_key, seed in itertools.product(models, seeds):
            run_cmd([
                sys.executable, "-m", "src.train",
                f"model.key={model_key}",
                f"model.seed={seed}"
            ], f"Train {model_key} (seed={seed})")
    
    # 3. Evaluation
    if not args.skip_eval:
        run_cmd([sys.executable, "-m", "src.evaluate"], "Evaluate All Models")
    
    # 4. Export Best Model for Deployment
    best_model = "deberta_v3_small"  # Update after seeing results
    run_cmd([
        sys.executable, "-m", "src.export_onnx",
        f"model_path=models/{best_model}-seed42/best_model"
    ], f"Export Best Model ({best_model}) for Deployment")
    
    print("\n🎉 FULL EXPERIMENT COMPLETE")
    print("Results: experiments/results/all_models_results.json")

if __name__ == "__main__":
    main()
