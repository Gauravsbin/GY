    # 6. MobileBERT (25M params) - MOBILE OPTIMIZED
    "mobilebert": {
        "class": BasePhishClassifier,
        "model_name": "google/mobilebert-uncased",
        "desc": "MobileBERT, bottleneck structure"
    },
    # 7. BigBird-RoBERTa (128M params) - LONG SEQUENCES
    "bigbird_roberta": {
        "class": BasePhishClassifier,
        "model_name": "google/bigbird-roberta-base",
        "desc": "BigBird with sparse attention for long emails"
    },
    # 8. BERT + CRF (110M + CRF) - TOKEN-LEVEL CUES
    "bert_crf": {
        "class": BertCRFPhishClassifier,
        "model_name": "bert-base-uncased",
        "desc": "BERT-base + CRF head for phishing cue extraction"
    },
}

def get_model(model_key: str, num_labels: int = 2, **kwargs) -> nn.Module:
    if model_key not in MODEL_REGISTRY:
        raise ValueError(f"Unknown model: {model_key}. Available: {list(MODEL_REGISTRY.keys())}")
    cfg = MODEL_REGISTRY[model_key]
    return cfg["class"](cfg["model_name"], num_labels=num_labels, **kwargs)

def get_tokenizer(model_key: str):
    cfg = MODEL_REGISTRY[model_key]
    return AutoTokenizer.from_pretrained(cfg["model_name"])

# ──────────────────────────────────────────────────────────────
# 4. ONNX RUNTIME WRAPPER FOR DEPLOYMENT
# ──────────────────────────────────────────────────────────────
class ONNXPhishModel:
    def __init__(self, onnx_path: str, tokenizer, max_length: int = 512):
        self.session = ort.InferenceSession(
            onnx_path,
            providers=["CPUExecutionProvider"]  # Cloud Run uses CPU
        )
        self.tokenizer = tokenizer
        self.max_length = max_length
        self.input_names = [inp.name for inp in self.session.get_inputs()]
        
    def predict_proba(self, texts: list[str]) -> np.ndarray:
        inputs = self.tokenizer(
            texts,
            padding=True,
            truncation=True,
            max_length=self.max_length,
            return_tensors="np"
        )
        # Filter inputs to match ONNX model signature
        onnx_inputs = {k: inputs[k] for k in self.input_names if k in inputs}
        logits = self.session.run(None, onnx_inputs)[0]
        probs = self._softmax(logits)
        return probs[:, 1]  # Phishing probability
    
    @staticmethod
    def _softmax(x: np.ndarray) -> np.ndarray:
        e_x = np.exp(x - np.max(x, axis=1, keepdims=True))
        return e_x / e_x.sum(axis=1, keepdims=True)

# ──────────────────────────────────────────────────────────────
# 5. EXPORT TO ONNX + QUANTIZATION
# ──────────────────────────────────────────────────────────────
def export_to_onnx(model: nn.Module, tokenizer, save_dir: Path, model_key: str, max_length: int = 512):
    model.eval()
    dummy_input = tokenizer(
        ["dummy text"] * 2,
        padding="max_length",
        truncation=True,
        max_length=max_length,
        return_tensors="pt"
    )
    
    onnx_path = save_dir / f"{model_key}.onnx"
    torch.onnx.export(
        model,
        (dummy_input["input_ids"], dummy_input["attention_mask"]),
        str(onnx_path),
        input_names=["input_ids", "attention_mask"],
        output_names=["logits"],
        dynamic_axes={
            "input_ids": {0: "batch", 1: "sequence"},
            "attention_mask": {0: "batch", 1: "sequence"},
            "logits": {0: "batch"}
        },
        opset_version=17,
        do_constant_folding=True,
        export_params=True
    )
    print(f"Exported ONNX: {onnx_path}")
    return onnx_path

def quantize_onnx_int8(onnx_path: Path, save_dir: Path) -> Path:
    from onnxruntime.quantization import quantize_dynamic, QuantType
    quant_path = save_dir / f"{onnx_path.stem}_int8.onnx"
    quantize_dynamic(
        str(onnx_path),
        str(quant_path),
        weight_type=QuantType.QInt8,
        optimize_model=True
    )
    print(f"Quantized INT8: {quant_path}")
    return quant_path
